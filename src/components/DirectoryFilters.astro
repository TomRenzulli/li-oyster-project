---
/**
 * The only interactive part of the directory.
 *
 * Every listing is server-rendered as a card; this island hides and shows them.
 * That means the full directory works with JavaScript disabled, filtering is
 * instant with no network round-trip, and there is no search index to keep in
 * sync with the content. At directory scale (tens to low hundreds of farms)
 * this is both faster and simpler than a client-side search engine.
 */
interface Facet {
  value: string;
  count: number;
}
interface Props {
  regions: Facet[];
  waterbodies: Facet[];
  towns: Facet[];
  types: Facet[];
  total: number;
}
const { regions, waterbodies, towns, types, total } = Astro.props;

const selects: { id: string; label: string; options: Facet[] }[] = [
  { id: 'region', label: 'Region', options: regions },
  { id: 'waterbody', label: 'Waterbody', options: waterbodies },
  { id: 'town', label: 'Town', options: towns },
  { id: 'type', label: 'Type', options: types },
];
---

<form
  id="directory-filters"
  class="border-navy-200 bg-salt-50 rounded border p-4"
  role="search"
  aria-label="Filter the directory"
>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <div class="lg:col-span-3">
      <label for="q" class="block text-sm font-semibold">
        Search farms
      </label>
      <input
        type="search"
        id="q"
        name="q"
        autocomplete="off"
        placeholder="Name, oyster, bay or town"
        class="border-navy-300 bg-salt-50 mt-1 w-full rounded border px-3 py-2"
      />
    </div>

    {selects.map((s) => (
      <div>
        <label for={s.id} class="block text-sm font-semibold">
          {s.label}
        </label>
        <select
          id={s.id}
          name={s.id}
          class="border-navy-300 bg-salt-50 mt-1 w-full rounded border px-3 py-2"
        >
          <option value="">All</option>
          {s.options.map((o) => (
            <option value={o.value}>
              {o.value} ({o.count})
            </option>
          ))}
        </select>
      </div>
    ))}

    <fieldset class="lg:col-span-2">
      <legend class="text-sm font-semibold">Only show farms that</legend>
      <div class="mt-1 flex flex-wrap gap-x-5 gap-y-2">
        <label class="flex items-center gap-2 text-sm">
          <input type="checkbox" id="direct" class="accent-brass-500 size-4" /> Sell direct
        </label>
        <label class="flex items-center gap-2 text-sm">
          <input type="checkbox" id="tours" class="accent-brass-500 size-4" /> Offer tours
        </label>
        <label class="flex items-center gap-2 text-sm">
          <input type="checkbox" id="ships" class="accent-brass-500 size-4" /> Ship
        </label>
      </div>
    </fieldset>

    <div>
      <label for="sort" class="block text-sm font-semibold">
        Sort
      </label>
      <select
        id="sort"
        name="sort"
        class="border-navy-300 bg-salt-50 mt-1 w-full rounded border px-3 py-2"
      >
        <option value="name">Name (A–Z)</option>
        <option value="name-desc">Name (Z–A)</option>
        <option value="verified">Most recently verified</option>
      </select>
    </div>
  </div>

  <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
    <p id="result-count" aria-live="polite" class="text-sm">
      Showing {total} of {total} listings
    </p>
    <button
      type="reset"
      class="border-navy-300 hover:border-brass-400 rounded border px-3 py-1.5 text-sm"
    >
      Clear filters
    </button>
  </div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('#directory-filters');
  const listEl = document.querySelector<HTMLElement>('#farm-list');
  const countEl = document.querySelector<HTMLElement>('#result-count');
  const empty = document.querySelector<HTMLElement>('#no-results');

  if (form && listEl && countEl) {
    const list = listEl;
    const count = countEl;
    const cards = Array.from(list.querySelectorAll<HTMLElement>('[data-farm]'));
    const total = cards.length;
    const val = (id: string) =>
      (document.querySelector<HTMLSelectElement | HTMLInputElement>(`#${id}`)?.value ?? '').trim();
    const checked = (id: string) =>
      document.querySelector<HTMLInputElement>(`#${id}`)?.checked ?? false;

    function apply() {
      const q = val('q').toLowerCase();
      const terms = q.split(/\s+/).filter(Boolean);
      const region = val('region');
      const waterbody = val('waterbody');
      const town = val('town');
      const type = val('type');

      let shown = 0;
      for (const card of cards) {
        const d = card.dataset;
        const matches =
          terms.every((t) => (d.text ?? '').includes(t)) &&
          (!region || d.region === region) &&
          (!waterbody || d.waterbody === waterbody) &&
          (!town || d.town === town) &&
          (!type || (d.type ?? '').split('|').includes(type)) &&
          (!checked('direct') || d.direct === 'true') &&
          (!checked('tours') || d.tours === 'true') &&
          (!checked('ships') || d.ships === 'true');

        card.hidden = !matches;
        if (matches) shown += 1;
      }

      const sort = val('sort');
      const sorted = [...cards].sort((a, b) => {
        const an = a.dataset.name ?? '';
        const bn = b.dataset.name ?? '';
        if (sort === 'name-desc') return bn.localeCompare(an);
        if (sort === 'verified') {
          return (b.dataset.verified ?? '').localeCompare(a.dataset.verified ?? '');
        }
        return an.localeCompare(bn);
      });
      for (const card of sorted) list.append(card);

      count.textContent = `Showing ${shown} of ${total} listings`;
      if (empty) empty.hidden = shown !== 0;
    }

    form.addEventListener('input', apply);
    form.addEventListener('reset', () => requestAnimationFrame(apply));
  }
</script>
