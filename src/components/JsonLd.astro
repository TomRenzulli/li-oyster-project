---
/**
 * Structured data. Rendered as application/ld+json, which a CSP without
 * script-src 'unsafe-inline' still permits: a JSON-LD block is data, not an
 * executable script, and is not covered by script-src.
 */
interface Props {
  schema: Record<string, unknown> | Record<string, unknown>[];
}
const { schema } = Astro.props;
const json = JSON.stringify(schema);
---

<script type="application/ld+json" is:inline set:html={json} />
