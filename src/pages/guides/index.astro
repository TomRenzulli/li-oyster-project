---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getPublishedGuides, assertGuideRelations } from '../../lib/guides';

// Run the relation check once, on the index, so a broken `related_guides`
// slug fails the build rather than shipping a dead link.
await assertGuideRelations();

const guides = await getPublishedGuides();

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Long Island oyster guides',
  itemListElement: guides.map((guide, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(`/guides/${guide.id}/`, Astro.site).href,
    name: guide.data.title,
  })),
};
---

<BaseLayout
  title="Guides"
  description="How to buy, keep, open and eat Long Island oysters — with every factual claim cited to its source."
  ogRoute="guides"
>
  <JsonLd schema={itemList} />

  <h1 class="font-display text-navy-900 text-4xl">Guides</h1>

  <p class="text-navy-700 mt-4 max-w-prose text-lg">
    Practical writing about buying, keeping, opening and eating Long Island oysters. These are
    original, but the facts in them are not ours: anything about safety, seasons or regulation cites
    the agency it came from, and each guide lists the questions it deliberately does
    <em>not</em> answer.
  </p>

  <ul class="mt-10 grid gap-6 sm:grid-cols-2">
    {guides.map((guide) => (
      <li class="border-navy-200 bg-salt-50 flex flex-col rounded border p-5">
        <h2 class="font-display text-navy-900 text-xl">
          <a href={`/guides/${guide.id}/`}>{guide.data.title}</a>
        </h2>
        <p class="text-navy-700 mt-2 grow text-sm">{guide.data.summary}</p>
        <p class="text-navy-500 mt-4 text-xs">
          {guide.data.health_claims && (
            <span class="bg-navy-800 text-salt-50 mr-2 rounded px-2 py-0.5">
              Cites health authorities
            </span>
          )}
          <span>Checked {guide.data.last_verified}</span>
        </p>
      </li>
    ))}
  </ul>

  <section class="border-navy-200 mt-16 border-t pt-8">
    <h2 class="font-display text-navy-900 text-2xl">Still being written</h2>
    <p class="text-navy-700 mt-3 max-w-prose">
      Four more guides are drafted but not published, because we have not yet sourced them to our
      own standard: Long Island seasons and merroir by waterbody, storing and preserving live
      oysters, hosting an oyster party, and restoration work in the bays. What each one is still
      missing is written down in the repository's <code>data/NEEDS_VERIFICATION.md</code>, not left
      to memory. An unsourced guide is worth less than no guide — see our
      <a href="/methodology/">methodology</a>.
    </p>
  </section>
</BaseLayout>
