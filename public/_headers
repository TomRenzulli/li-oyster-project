# Security headers for Cloudflare Pages.
#
# The CSP allowlists only what the site uses today. Each origin below names the
# feature that needs it; adding one belongs in the PR of the feature that needs
# it. No 'unsafe-inline' for script-src and no 'unsafe-eval', ever.
#
# Granted so far:
#   img-src        https://*.tile.openstreetmap.org  /map/ basemap tiles
#   script-src     https://challenges.cloudflare.com Turnstile widget (/submit/, /claim/)
#   frame-src      https://challenges.cloudflare.com Turnstile renders in an iframe
#   style-src-attr 'unsafe-inline'                   see note below
#
# Not yet granted, expected later:
#   script-src + connect-src  https://static.cloudflareinsights.com  (analytics, Phase 5)
#   script-src + frame-src    https://js.stripe.com                  (shop, Phase 4)
#
# `data:` is deliberately absent from img-src: nothing we serve uses a data URI
# (astro.config sets assetsInlineLimit:0, so no asset is ever inlined). If the
# Pagefind UI bundle is ever adopted, its CSS does use data URIs and this needs
# revisiting.
#
# Note on style-src-attr: Leaflet positions tiles and markers by writing
# `style="transform: ..."` directly onto elements, and CSP governs inline style
# ATTRIBUTES separately from <style> blocks. Granting 'unsafe-inline' only on
# style-src-attr keeps the much more dangerous `style-src` on 'self' — inline
# and injected <style> blocks stay blocked — while letting the map work.
# Astro is configured with inlineStylesheets:'never' so style-src needs no
# relaxation. If the map is ever dropped, drop this directive with it.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' https://*.tile.openstreetmap.org; font-src 'self'; connect-src 'self'; manifest-src 'self'; frame-src https://challenges.cloudflare.com; form-action 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), ambient-light-sensor=(), autoplay=(), battery=(), camera=(), display-capture=(), document-domain=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Robots-Tag: all

# Hashed build assets are immutable.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/*
  Cache-Control: public, max-age=86400

/og/*
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

# Never cache the submission endpoint.
/api/*
  Cache-Control: no-store
