# Local development only. Never commit a filled-in .env.
# Production values live in Cloudflare Pages environment variables and
# GitHub Actions secrets — see docs/GITHUB_SECRETS.md.

# Cloudflare Turnstile (Phase 2: /submit/ and /claim/)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# GitHub token for filing submissions as issues (Phase 2)
# Fine-grained PAT, issues:write on this repository only.
GITHUB_ISSUE_TOKEN=

# Cloudflare Web Analytics beacon token (Phase 5)
PUBLIC_CF_ANALYTICS_TOKEN=
